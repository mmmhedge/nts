{
  "manifest_version": 3,
  "name": "Tuna",
  "version": "0.1.0",
  "description": "Unofficial extension for nts.live -- enjoy",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["offscreen", "storage", "alarms", "notifications"],
  "host_permissions": [
    "https://www.nts.live/*",
    "https://*.ntslive.net/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
